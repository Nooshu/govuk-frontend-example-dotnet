@page "/apply/country"
@model CountryModel
@{
    ViewData["Title"] = "Where will you fish?";
    ViewData["BackLink"] = "/apply/date-of-birth";
}
<form method="post" novalidate>
@if (Model.Error is not null)
{
    @GovUkHtml.Component("error-summary", new System.Text.Json.Nodes.JsonObject
    {
        ["titleText"] = "There is a problem",
        ["errorList"] = new System.Text.Json.Nodes.JsonArray
        {
            new System.Text.Json.Nodes.JsonObject { ["text"] = Model.Error, ["href"] = "#country" },
        },
    })
}
@{
    var items = new System.Text.Json.Nodes.JsonArray();
    foreach (var country in LicenceJourney.Countries)
    {
        var item = new System.Text.Json.Nodes.JsonObject { ["value"] = country, ["text"] = country };
        if (Model.Country == country)
        {
            item["checked"] = true;
        }

        items.Add(item);
    }

    var radios = new System.Text.Json.Nodes.JsonObject
    {
        ["idPrefix"] = "country",
        ["name"] = "country",
        ["fieldset"] = new System.Text.Json.Nodes.JsonObject
        {
            ["legend"] = new System.Text.Json.Nodes.JsonObject
            {
                ["text"] = "Where will you fish?",
                ["isPageHeading"] = true,
                ["classes"] = "govuk-fieldset__legend--l",
            },
        },
        ["hint"] = new System.Text.Json.Nodes.JsonObject
        {
            ["text"] = "This example is fictional. It does not check a real fishing area.",
        },
        ["items"] = items,
    };
    if (Model.Error is not null)
    {
        radios["errorMessage"] = new System.Text.Json.Nodes.JsonObject { ["text"] = Model.Error };
    }
}
@GovUkHtml.Component("radios", radios)
@GovUkHtml.Component("button", new System.Text.Json.Nodes.JsonObject { ["text"] = "Continue" })
</form>
