@inject GovUk.Frontend.Example.Hosting.AssetManifest Assets
@{
    var title = ViewData["Title"] as string ?? "GOV.UK Frontend example";
    var backLink = ViewData["BackLink"] as string;
    var path = Context.Request.Path.Value ?? "/";
    var onApply = path.StartsWith("/apply", StringComparison.Ordinal);
    var onComponents = path == "/" || path.StartsWith("/components", StringComparison.Ordinal);
    var catalogue = ViewData["CatalogueLayout"] is true;
    var fullWidth = ViewData["FullWidth"] is true;
    var navigation = new System.Text.Json.Nodes.JsonArray
    {
        new System.Text.Json.Nodes.JsonObject
        {
            ["href"] = "/apply",
            ["text"] = "Start",
            ["current"] = onApply,
        },
        new System.Text.Json.Nodes.JsonObject
        {
            ["href"] = "/",
            ["text"] = "Components",
            ["current"] = onComponents && !onApply,
        },
    };
    var serviceNavigation = new System.Text.Json.Nodes.JsonObject
    {
        ["serviceName"] = "Apply for a fishing rod licence",
        ["serviceUrl"] = "/apply",
    };
    if (catalogue)
    {
        var language = GovUkHtml.Render("language-navigation", new System.Text.Json.Nodes.JsonObject
        {
            ["ariaLabel"] = "Language",
            ["items"] = new System.Text.Json.Nodes.JsonArray
            {
                new System.Text.Json.Nodes.JsonObject { ["text"] = "English", ["lang"] = "en", ["current"] = true },
                new System.Text.Json.Nodes.JsonObject { ["text"] = "Cymraeg", ["lang"] = "cy", ["href"] = "/" },
            },
        });
        serviceNavigation["slots"] = new System.Text.Json.Nodes.JsonObject
        {
            ["end"] = new System.Text.Json.Nodes.JsonObject
            {
                ["html"] = language,
                ["align"] = "inline",
            },
        };
    }
    else
    {
        serviceNavigation["navigation"] = navigation;
    }

    var phaseHtml = catalogue
        ? "This is a demonstration – it is not a government service. Your <a class=\"govuk-link\" href=\"/\">feedback</a> will help us improve the example."
        : "This is a fictional example. It does not issue a fishing rod licence.";
    var column = fullWidth ? "govuk-grid-column-full" : "govuk-grid-column-two-thirds";
}
<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <title>@title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0b0c0c">
    <link rel="stylesheet" href="@Assets.Stylesheet">
</head>
<body class="govuk-template__body">
    <script>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>
    @GovUkHtml.Component("skip-link")
    <div class="govuk-template__header">
        @GovUkHtml.Component("header", new System.Text.Json.Nodes.JsonObject { ["homepageUrl"] = "/" })
        @GovUkHtml.Component("service-navigation", serviceNavigation)
    </div>
    <div class="govuk-width-container">
        @GovUkHtml.Component("phase-banner", new System.Text.Json.Nodes.JsonObject
        {
            ["tag"] = new System.Text.Json.Nodes.JsonObject { ["text"] = "Example" },
            ["html"] = phaseHtml,
        })
        @if (backLink is not null)
        {
            @GovUkHtml.Component("back-link", new System.Text.Json.Nodes.JsonObject { ["href"] = backLink })
        }
        <main class="govuk-main-wrapper" id="content">
            @if (catalogue)
            {
                @GovUkHtml.Component("notification-banner", new System.Text.Json.Nodes.JsonObject
                {
                    ["classes"] = "app-demo-banner",
                    ["titleId"] = "app-demo-banner-title",
                    ["titleText"] = "Important",
                    ["text"] = "This is a live demo. It is not a real government service.",
                })
            }
            <div class="govuk-grid-row">
                <div class="@column">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>
    @if (catalogue)
    {
        @GovUkHtml.Component("footer", new System.Text.Json.Nodes.JsonObject
        {
            ["meta"] = new System.Text.Json.Nodes.JsonObject
            {
                ["items"] = new System.Text.Json.Nodes.JsonArray
                {
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/help", ["text"] = "Help" },
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/fees", ["text"] = "Licence fees" },
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/updates", ["text"] = "Service updates" },
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/guidance", ["text"] = "Guidance" },
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/cookies", ["text"] = "Cookies" },
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/accessibility", ["text"] = "Accessibility" },
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/", ["text"] = "About this example" },
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/", ["text"] = "Component catalogue" },
                    new System.Text.Json.Nodes.JsonObject { ["href"] = "/", ["text"] = "Example pages" },
                },
            },
        })
    }
    else
    {
        @GovUkHtml.Component("footer")
    }
    <script type="module" src="@Assets.Script"></script>
</body>
</html>
