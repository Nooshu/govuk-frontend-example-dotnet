{
  "name": "govuk-frontend-example",
  "version": "0.0.0",
  "private": true,
  "description": "C# / ASP.NET Core example of a GDS-compliant frontend using GOV.UK Frontend. Shared Sass pipeline, performance/security baseline, and Node tooling for docs hygiene.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build:styles": "node scripts/build-styles-cli.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "test": "node --test --experimental-test-coverage --test-coverage-include='baseline/**/*.mjs' --test-coverage-include='scripts/build-styles.mjs' --test-coverage-include='scripts/build-assets.mjs' --test-coverage-include='scripts/dotnet-executable.mjs' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "verify:docs": "npm run format:check && npm run lint:md",
    "verify": "npm run verify:docs && npm run build:styles && npm test"
  },
  "dependencies": {
    "govuk-frontend": "6.5.1"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.3",
    "nunjucks": "3.2.4",
    "prettier": "3.9.9",
    "sass": "1.105.1"
  }
}
